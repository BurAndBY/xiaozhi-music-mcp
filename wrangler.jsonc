{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xiaozhi-music-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONNECTOR", "class_name": "XiaozhiConnector" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["XiaozhiConnector"] }
  ]
}
