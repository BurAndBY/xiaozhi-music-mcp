{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xiaozhi-music-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://xiaozhi-music-mcp.burandby.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONNECTOR", "class_name": "XiaozhiConnector" },
      { "name": "NOTIFICATIONS", "class_name": "NotificationScheduler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["XiaozhiConnector"] },
    { "tag": "v2", "new_sqlite_classes": ["NotificationScheduler"] }
  ]
}
